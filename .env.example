# Copy to .env.local for local testing. On Vercel, set these as project
# environment variables instead (vercel env add ...).

# Bot that sends the results (from @BotFather)
TELEGRAM_BOT_TOKEN=
# Your own chat id with that bot (the teacher who receives results)
TELEGRAM_CHAT_ID=
# Time zone used for times in the report
REPORT_TZ=Asia/Tashkent
